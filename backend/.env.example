DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/quizme?retryWrites=true&w=majority"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"

# Optional — enables the "Generate from Notes" AI question feature for teachers.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
